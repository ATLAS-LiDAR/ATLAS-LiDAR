+from pcdet.ops.iou3d_nms import iou3d_nms_utils
+# import debugpy
+def get_iou_threshold(cls_id):
+    cls_id = int(cls_id)
+    if cls_id == 1:
+        return 0.7
+    elif cls_id in [2, 3]:
+        return 0.5
+    else:
+        return None
+
+
+
+def find_best_match(spoof_gt, frame_pred):
+    cls_id = int(spoof_gt[-1])
+    thr = get_iou_threshold(cls_id)
+
+    pred_boxes = frame_pred.get('boxes_lidar', None)
+    pred_labels = np.array(frame_pred.get('pred_labels', []))
+    pred_scores = np.array(frame_pred.get('score', []))
+
+    if thr is None or pred_boxes is None or len(pred_boxes) == 0:
+        return {
+            'class_id': cls_id,
+            'threshold': thr,
+            'max_iou': 0.0,
+            'score': None
+        }
+
+    cls_mask = (pred_labels == cls_id)
+    if not np.any(cls_mask):
+        return {
+            'class_id': cls_id,
+            'threshold': thr,
+            'max_iou': 0.0,
+            'score': None
+        }
+
+    cls_boxes = pred_boxes[cls_mask]
+    cls_scores = pred_scores[cls_mask]
+
+    gt_tensor = torch.tensor(spoof_gt[:7], dtype=torch.float32).unsqueeze(0).cuda()
+    pred_tensor = torch.tensor(cls_boxes[:, :7], dtype=torch.float32).cuda()
+
+    iou = iou3d_nms_utils.boxes_iou3d_gpu(pred_tensor, gt_tensor)  # (N, 1)
+    max_iou, best_idx = iou[:, 0].max(0)
 
+    return {
+        'class_id': cls_id,
+        'threshold': thr,
+        'max_iou': float(max_iou.item()),
+        'score': float(cls_scores[best_idx.item()])
+    }
 
